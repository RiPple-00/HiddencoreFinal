# Release signing credentials — copy this file to keystore.properties (gitignored) and fill in.
#
# Generate a keystore yourself (this is a sensitive, long-lived credential — do it locally,
# never let a script/agent generate or transmit it):
#
#   keytool -genkeypair -v -keystore app/release-keystore.jks -alias ddasum-release \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is relative to the android/ project root (where this file lives).
storeFile=app/release-keystore.jks
storePassword=
keyAlias=ddasum-release
keyPassword=
